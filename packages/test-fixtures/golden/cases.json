    "expected": {
      "statuses": ["malformed", "malformed"],
      "directions": ["down", "down"],
      "rawLineIndices": [0, 1],
      "issueCodes": ["MIXED_PROCESS_TYPES"],
      "summary": { "totalLines": 2, "targetLines": 2, "translated": 0, "unknown": 0, "malformed": 2 }
    }
  },
