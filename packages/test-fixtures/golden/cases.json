  {
    "name": "invalid hex does not block a later command",
    "rule": "An invalid target is retained as malformed while a later valid target still determines the process type and translates.",
    "inputLog": "[WIRE:TX] GG:31:C4:8E:72:9A\nsynthetic aurora heartbeat\n[WIRE:TX] F1:31:C4:8E:72:9A:4D:4C:B2:2A",
    "expected": {
      "processType": "single",
      "statuses": ["malformed", "translated"],
      "directions": ["down", "down"],
      "rawLineIndices": [0, 2],
      "issueCodes": ["INVALID_HEX"],
      "summary": { "totalLines": 3, "targetLines": 2, "translated": 1, "unknown": 0, "malformed": 1 }
    }
  },
  {
    "name": "one-byte line does not block detection",
    "rule": "A decoded target with fewer than two bytes is malformed, but a later target can still determine the whole-log process type.",
    "inputLog": "[WIRE:TX] F1\n[WIRE:TX] F1:31:C4:8E:72:9A:4D:4C:B2:2A",
    "expected": {
      "processType": "single",
      "statuses": ["malformed", "translated"],
      "directions": ["down", "down"],
      "rawLineIndices": [0, 1],
      "issueCodes": ["INSUFFICIENT_BYTES"],
      "summary": { "totalLines": 2, "targetLines": 2, "translated": 1, "unknown": 0, "malformed": 1 }
    }
  },
